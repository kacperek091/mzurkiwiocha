<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oficjalny Portal Wsi MZURKI.EXE</title>

<!--
==========================================================
JEŚLI TO CZYTASZ, ZNALAZŁEŚ SEKRET.
MZURKI NIE ISTNIEJĄ.
TO PROJEKCJA.
SPRAWDŹ KONSOLĘ.
HASŁO DO STREFY TAJNEJ:
"kapusta666"
==========================================================
-->

<style>
:root{
    --bg1:#0f0f0f;
    --bg2:#1a001f;
    --neon1:#00ffea;
    --neon2:#ff00c8;
    --neon3:#00ff00;
    --danger:#ff0033;
}

body{
    margin:0;
    font-family: 'Courier New', monospace;
    background:linear-gradient(120deg,var(--bg1),var(--bg2));
    color:white;
    overflow-x:hidden;
    transition:0.5s;
}

body.light{
    --bg1:#f0f0f0;
    --bg2:#ffffff;
    color:#111;
}

section{
    padding:60px 20px;
    border-bottom:2px dashed var(--neon1);
}

h1,h2,h3{
    text-transform:uppercase;
    letter-spacing:3px;
}

.glitch{
    font-size:48px;
    position:relative;
    animation:glitch 2s infinite;
}

@keyframes glitch{
    0%{text-shadow:2px 0 var(--neon1), -2px 0 var(--neon2);}
    25%{text-shadow:-2px 0 var(--neon2), 2px 0 var(--neon3);}
    50%{text-shadow:2px 2px var(--danger);}
    75%{text-shadow:-2px -2px var(--neon1);}
    100%{text-shadow:2px 0 var(--neon2);}
}

button{
    padding:10px 20px;
    margin:5px;
    background:black;
    border:2px solid var(--neon1);
    color:var(--neon1);
    cursor:pointer;
    animation:blink 2s infinite;
}

button:hover{
    background:var(--neon2);
    color:black;
}

@keyframes blink{
    0%,100%{opacity:1;}
    50%{opacity:0.7;}
}

.hero{
    height:100vh;
    background:radial-gradient(circle at center, #220022, #000000);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.map{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.building{
    border:2px solid var(--neon2);
    padding:30px;
    text-align:center;
    cursor:pointer;
    background:#111;
}

.building:hover{
    background:var(--neon2);
}

.counter{
    font-size:40px;
    color:var(--neon3);
}

.camera{
    background:black;
    border:2px solid var(--danger);
    height:200px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}

#secretZone{
    display:none;
    background:#000;
    padding:40px;
    border:3px solid var(--danger);
}

.apocalypse{
    animation:shake 0.1s infinite;
    background:black !important;
}

@keyframes shake{
    0%{transform:translate(2px,2px);}
    25%{transform:translate(-2px,-2px);}
    50%{transform:translate(2px,-2px);}
    75%{transform:translate(-2px,2px);}
    100%{transform:translate(0,0);}
}

.totalChaos{
    animation:spin 0.5s infinite linear;
    filter:hue-rotate(360deg) contrast(300%);
}

@keyframes spin{
    0%{transform:rotate(0deg);}
    100%{transform:rotate(360deg);}
}

.gallery img{
    width:100px;
    margin:5px;
    cursor:pointer;
    border:2px solid var(--neon1);
}

.lightbox{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.9);
    align-items:center;
    justify-content:center;
}

.lightbox img{
    max-width:80%;
    border:5px solid white;
}
</style>
</head>
<body>

<section class="hero">
    <h1 class="glitch">MZURKI – EPICENTRUM CHAOSU I KAPUSTY</h1>
    <p>Oficjalny Portal Administracyjno-Paranoiczny Wsi Mzurki</p>
    <div class="counter" id="populationCounter">Populacja: 0</div>
    <button onclick="toggleMode()">PRZEŁĄCZ TRYB JASNY/CIEMNY</button>
    <button onclick="randomBackground()">LOSOWE TŁO</button>
</section>

<section>
<h2>Generator Mieszkańca</h2>
<button onclick="generateVillager()">Generuj Nowego Obywatela</button>
<div id="villagerOutput"></div>
</section>

<section>
<h2>Mapa Wsi</h2>
<div class="map">
<div class="building" onclick="buildingInfo('Remiza')">REMIZA</div>
<div class="building" onclick="buildingInfo('Sklep u Haliny')">SKLEP U HALINY</div>
<div class="building" onclick="buildingInfo('Dom Sołtysa')">DOM SOŁTYSA</div>
<div class="building" onclick="buildingInfo('Stara Studnia')">STARA STUDNIA</div>
<div class="building" onclick="buildingInfo('Boisko')">BOISKO</div>
<div class="building" onclick="buildingInfo('Tajemnicza Szopa')">TAJEMNICZA SZOPA</div>
</div>
<div id="mapInfo"></div>
</section>

<section>
<h2>Symulator Dram w Remizie</h2>
<button onclick="simulateDrama()">URUCHOM DRAMĘ</button>
<div id="dramaOutput"></div>
</section>

<section>
<h2>Ranking Największych Skandali</h2>
<ol>
<li>Krystian “Betoniarka” Nowak i sprawa 47 worków cementu</li>
<li>Halina vs Grażyna – wojna o pietruszkę 2014</li>
<li>Zniknięcie koguta Janusza</li>
<li>Paranormalne dźwięki z obory sołtysa</li>
<li>Nielegalne disco polo w stodole</li>
</ol>
</section>

<section>
<h2>Kamera Monitoringu</h2>
<div class="camera" id="cameraFeed">ŁADOWANIE OBRAZU...</div>
</section>

<section>
<h2>Strefa Tajna</h2>
<input type="password" id="secretPass" placeholder="Wpisz hasło">
<button onclick="unlockSecret()">ODKRYJ PRAWDĘ</button>
<div id="secretZone">
<h3>WITAJ W PRAWDZIE</h3>
<p>Mzurki to eksperyment społeczny. Sołtys to hologram.</p>
<button onclick="activateTotalChaos()">TRYB TOTALNE ODJEBANIE</button>
</div>
</section>

<section>
<h2>Galeria</h2>
<div class="gallery">
<img src="https://picsum.photos/200?1" onclick="openLightbox(this.src)">
<img src="https://picsum.photos/200?2" onclick="openLightbox(this.src)">
<img src="https://picsum.photos/200?3" onclick="openLightbox(this.src)">
</div>
</section>

<div class="lightbox" id="lightbox" onclick="closeLightbox()">
<img id="lightboxImg">
</div>

<section>
<h2>Apokalipsa</h2>
<button onclick="apocalypse()">AKTYWUJ KONIEC MZUREK</button>
</section>

<script>
console.log("Witaj w konsoli Mzurek.");
console.log("Wpisz: mzurki();");

function mzurki(){
    console.log("Mzurki obserwują.");
}

let population = 213;
setInterval(()=>{
    population += Math.floor(Math.random()*5 -2);
    if(population<150) population=150;
    if(population>400) population=400;
    document.getElementById("populationCounter").innerText="Populacja: "+population;
},2000);

function toggleMode(){
    document.body.classList.toggle("light");
    clickSound();
}

function randomBackground(){
    const colors=[
        "linear-gradient(120deg,#000,#330033)",
        "linear-gradient(120deg,#001,#004)",
        "linear-gradient(120deg,#200,#020)"
    ];
    document.body.style.background=colors[Math.floor(Math.random()*colors.length)];
    clickSound();
}

function generateVillager(){
    const names=["Janusz","Grażyna","Sebastian","Karyna","Bogdan","Halina","Krystian","Andrzej"];
    const scandals=["zjadł 5kg ogórków na raz","ukradł krasnala ogrodowego","wierzy że kapusta rządzi światem","ma 17 anten satelitarnych","twierdzi że remiza to portal"];
    const roles=["Specjalista ds. plotek","Mistrz grilla","Strażnik studni","Oficjalny paranoik","Prezes koła gołębi"];
    let output=names[Math.floor(Math.random()*names.length)]+" lat "+(18+Math.floor(Math.random()*60))+
    ", "+roles[Math.floor(Math.random()*roles.length)]+", Skandal: "+scandals[Math.floor(Math.random()*scandals.length)];
    document.getElementById("villagerOutput").innerText=output;
    clickSound();
}

function buildingInfo(name){
    document.getElementById("mapInfo").innerText="Wchodzisz do: "+name+". Atmosfera dziwna, ktoś patrzy.";
    clickSound();
}

function simulateDrama(){
    const dramas=[
        "Grażyna rzuciła sałatką w sołtysa.",
        "Janusz oskarżył koguta o zdradę.",
        "Remiza zaczęła świecić na zielono.",
        "Ktoś puścił disco polo o 3:17."
    ];
    document.getElementById("dramaOutput").innerText=dramas[Math.floor(Math.random()*dramas.length)];
    clickSound();
}

setInterval(()=>{
    const feed=[
        "Kamera 1: Halina krąży podejrzanie.",
        "Kamera 2: Kot patrzy w pustkę.",
        "Kamera 3: Wiatr przesuwa wiadro.",
        "Kamera 4: Nic. Absolutnie nic."
    ];
    document.getElementById("cameraFeed").innerText=feed[Math.floor(Math.random()*feed.length)];
},3000);

function unlockSecret(){
    const pass=document.getElementById("secretPass").value;
    if(pass==="kapusta666"){
        document.getElementById("secretZone").style.display="block";
    } else {
        alert("Złe hasło. Sołtys wie.");
    }
    clickSound();
}

function apocalypse(){
    document.body.classList.add("apocalypse");
    alert("MZURKI UPADAJĄ.");
}

function activateTotalChaos(){
    document.body.classList.add("totalChaos");
}

function openLightbox(src){
    document.getElementById("lightboxImg").src=src;
    document.getElementById("lightbox").style.display="flex";
    clickSound();
}

function closeLightbox(){
    document.getElementById("lightbox").style.display="none";
}

function clickSound(){
    let audio=new Audio("https://www.soundjay.com/buttons/sounds/button-16.mp3");
    audio.play();
}
</script>

</body>
</html>
